; Engine configuration file.
; Godot State Machine
; A node-based finite state machine: one node per state, transitions by signal.
; The demo: slimes that idle, roam, chase, telegraph a leap, stagger and die.
; Open this folder in Godot 4.7+ and press F5.

config_version=5

[application]

config/name="Godot State Machine"
config/description="A node-based finite state machine for Godot 4, with a slime enemy that idles, roams, chases, leaps, staggers and dies. From codingquests.io"
run/main_scene="res://demo/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/kenney_tiny-dungeon/tile_0108.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; Keeps the state labels sharp under the 2x camera zoom.
theme/default_font_multichannel_signed_distance_field=true

